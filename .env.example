# ==============================================================================
# SMART F&B OS - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép tệp này thành .env trên môi trường local và điền giá trị tương ứng:
# cp .env.example .env

# --- CƠ SỞ DỮ LIỆU POSTGRESQL 16 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_fb_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev_2026
CONNECTION_STRING=Host=localhost;Port=5432;Database=smart_fb_db;Username=postgres;Password=postgres_password_dev_2026;Include Error Detail=true

# --- BỘ NHỚ ĐỆM REDIS 7 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379,abortConnect=false,connectTimeout=5000

# --- BẢO MẬT & JWT AUTHENTICATION ---
JWT_SECRET=super_secret_jwt_key_smart_fb_os_production_standard_256bit_min_length_2026
JWT_ISSUER=SmartFB_AuthServer
JWT_AUDIENCE=SmartFB_AppClients
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- CỔNG THANH TOÁN VIETQR / PAYOS ---
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_WEBHOOK_URL=http://localhost:5000/api/v1/payments/webhook

# --- GOOGLE GEMINI 1.5 FLASH AI ENGINE ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- CỔNG PORT & URL FRONTEND/BACKEND ---
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# --- THÔNG SỐ ĐẶC THÙ NGHIỆP VỤ ---
DELIVERY_FLAT_FEE=20000
TAKEAWAY_LOYALTY_THRESHOLD=10
