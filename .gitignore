# ==========================================
# SMART F&B OS - GIT IGNORE CONFIGURATION
# ==========================================

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx

# --- .NET Build & Cache Artifacts ---
backend/**/bin/
backend/**/obj/
backend/**/out/
backend/**/.vs/
backend/**/_ReSharper*/
backend/**/*.user
backend/**/*.userosscache
backend/**/*.suo
backend/**/*.userprefs
*.DotSettings.user

# --- Node.js & Next.js Artifacts ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/.npm
frontend/.turbo
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker & Database Volumes ---
.docker/
docker-data/
postgres-data/
redis-data/

# --- IDE & OS Files ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo

# --- Logs & Test Reports ---
logs/
*.log
TestResults/
*.trx
*.coverage
__pycache__/
*.pyc
tests/**/bin/
tests/**/obj/
.agents/**/bin/
.agents/**/obj/
.agents/**/__pycache__/
